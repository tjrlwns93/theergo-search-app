# 이 파일은 예시입니다. 복사해서 .env 를 만들고 실제 값을 채우세요.
#   cp .env.example .env
# .env 는 .gitignore 에 있어 깃허브에 올라가지 않습니다.
#
# ⚠️ Streamlit Cloud 에서는 .env 를 읽지 않습니다.
#    같은 키를 앱 Settings > Secrets 에 넣어야 합니다.

GOOGLE_CLIENT_ID=구글-OAuth-Client-ID
GOOGLE_CLIENT_SECRET=구글-OAuth-Client-Secret
ADMIN_EMAILS=admin1@ermore.co.kr,admin2@ermore.co.kr
ALLOWED_DOMAIN=ermore.co.kr
APP_URL=https://이-앱-URL/
