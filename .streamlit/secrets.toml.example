# 이 파일은 "예시" 입니다. 복사해서 secrets.toml 을 만들고 실제 값을 채우세요.
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
# secrets.toml 은 .gitignore 에 있어 깃허브에 올라가지 않습니다.
#
# Streamlit Community Cloud 에 배포할 때는 이 내용을
# 앱 설정 > Secrets 화면에 그대로 붙여넣으면 됩니다.

# 화면 접근용 로그인 비밀번호 (원하는 값으로)
app_password = "여기에-원하는-로그인-비밀번호"

# Supabase(PostgreSQL) 연결 문자열.
# ⚠️ 아래 "direct" 주소(db.xxxx.supabase.co)는 IPv6 전용이라
#    일반 PC / Streamlit Cloud(IPv4) 에서는 연결이 안 됩니다.
#    Supabase 대시보드 > Connect > "Session pooler" 의 IPv4 주소를 쓰세요.
#
# 권장 (Session Pooler, IPv4):
#   postgresql://postgres.xclcqtkgiivmkqlyasmn:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# 참고 (Direct, IPv6 전용 — IPv6 되는 환경에서만):
#   postgresql://postgres:[YOUR-PASSWORD]@db.xclcqtkgiivmkqlyasmn.supabase.co:5432/postgres
db_url = "postgresql://postgres.xclcqtkgiivmkqlyasmn:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres"
