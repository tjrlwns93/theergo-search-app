# 이 파일은 "예시" 입니다. 복사해서 secrets.toml 을 만들고 실제 값을 채우세요.
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
# secrets.toml 은 .gitignore 에 있어 깃허브에 올라가지 않습니다.
#
# Streamlit Community Cloud 에 배포할 때는 이 내용을
# 앱 설정 > Secrets 화면에 그대로 붙여넣으면 됩니다.

# 화면 접근용 로그인 비밀번호 (원하는 값으로)
app_password = "여기에-원하는-로그인-비밀번호"

# ── Supabase(PostgreSQL) 접속정보 ─────────────────────────────
# ⚠️ Supabase 대시보드 > Connect > "Session pooler" 값을 그대로 복사하세요.
#    (direct 주소 db.xxxx.supabase.co 는 IPv6 전용이라 클라우드에서 안 됩니다.)
#
# ▶ 방법 1 (권장): 항목별로 입력 — 비번에 특수문자(@ : / 등)가 있어도 안전.
#   db_host 에는 대시보드에 보이는 host 를 "그대로" 붙여넣으세요.
#   (예: aws-0-ap-northeast-2.pooler.supabase.com — <region> 같은 자리표시자 아님!)
db_host = "aws-0-ap-northeast-2.pooler.supabase.com"
db_port = 5432
db_user = "postgres.xclcqtkgiivmkqlyasmn"
db_password = "여기에-실제-DB-비밀번호"
db_name = "postgres"

# ▶ 방법 2: 전체 URL 로 한 번에 (db_host 를 안 쓸 때만).
#   비번에 특수문자가 있으면 URL 인코딩이 필요하니 방법 1 을 권장합니다.
# db_url = "postgresql://postgres.xclcqtkgiivmkqlyasmn:비번@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

# ── 노션 연동 (선택) ──────────────────────────────────────────
# notion_token: 노션 인테그레이션 토큰(ntn_...). 해당 DB 를 인테그레이션에 공유해야 함.
# notion_db_id: 대상 데이터베이스 ID.
# notion_person_id: '담당자'(people 칸)로 넣을 노션 사용자 ID.
notion_token = "ntn_여기에-토큰"
notion_db_id = "노션-데이터베이스-ID"
notion_person_id = "담당자로-넣을-노션-사용자-ID"

# ── 카페24 관리자 API (선택) ──────────────────────────────────
# cafe24_redirect_uri 는 카페24 개발자센터 앱에 등록한 값과 "정확히" 같아야 함(= 이 앱 URL).
cafe24_mall_id = "몰-아이디 (예: ergo2)"
cafe24_client_id = "개발자센터-앱-Client-ID"
cafe24_client_secret = "개발자센터-앱-Client-Secret"
cafe24_redirect_uri = "https://<이-앱-URL>/"

# ── 로그인/권한 (구글 로그인) ─────────────────────────────────
# 로컬은 .env 로도 됩니다. Streamlit Cloud 는 .env 를 안 읽으니 여기(Secrets)에 넣으세요.
GOOGLE_CLIENT_ID = "구글-OAuth-Client-ID"
GOOGLE_CLIENT_SECRET = "구글-OAuth-Client-Secret"
ADMIN_EMAILS = "tjrlwns93@ermore.co.kr,rho_js@ermore.co.kr,shheo@ermore.co.kr"
ALLOWED_DOMAIN = "ermore.co.kr"
APP_URL = "https://<이-앱-URL>/"
